        }
      }
    },
    "Pick your work city and Home shows the high/low on each day of the agenda.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu ciudad de trabajo y Inicio muestra la máxima/mínima en cada día de la agenda."
          }
        }
      }
    },
    "Color theme, rounded or regular font, high contrast, and language — all set in the next steps.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema de color, fuente redondeada o normal, alto contraste e idioma — todo en los siguientes pasos."
          }
        }
      }
    },
    "Add the Next Shift widget to your Lock Screen to see what’s coming and how long until it starts.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega el widget Próximo turno a la pantalla de bloqueo para ver qué sigue y cuánto falta."
          }
        }
      }
    },
    "I’ll unlock the Keys tab with a passcode.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquearé la pestaña Llaves con un código."
          }
        }
      }
    },
    "Skip Keys — you can change this later in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitir Llaves — puedes cambiarlo después en Ajustes."
          }
        }
      }
    },
    "Ask a CS Supervisor for the store passcode if you don’t have it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide el código de la tienda a un supervisor CS si no lo tienes."
          }
        }
      }
    },
    "Softer system rounded type — the app default.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipografía redondeada del sistema — la predeterminada de la app."
          }
        }
      }
    },
    "Standard system font.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuente estándar del sistema."
