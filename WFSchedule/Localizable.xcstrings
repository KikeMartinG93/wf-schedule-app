      }
    },
    "Sign in with UKG once and your shifts sync in the background, on a month calendar or a simple list.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión una vez con UKG y tus turnos se sincronizan en segundo plano, en un calendario mensual o en una lista sencilla."
          }
        }
      }
    },
    "Sign in with UKG Pro": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión con UKG Pro"
          }
        }
      }
    },
    "Sign in with your Whole Foods team member account directly through Amazon SSO to keep your schedule seamlessly in sync.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con tu cuenta de miembro del equipo de Whole Foods directamente a través del inicio de sesión de Amazon para mantener tu horario sincronizado."
          }
        }
      }
    },
    "Sign in with your Whole Foods team member account. Your credentials go directly into the sign-in page below — this app never sees them.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con tu cuenta de miembro del equipo de Whole Foods. Tus credenciales van directamente a la página de inicio de sesión de abajo; esta app nunca las ve."
          }
        }
      }
    },
    "Sign out": {
      "extractionState": "manual",
      "localizations": {
