    "Full color themes.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Temas a todo color."
          }
        }
      }
    },
    "Black, white, and gray only — including widgets.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo blanco, negro y gris — incluidos los widgets."
          }
        }
      }
    },
    "You can change this anytime in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiarlo cuando quieras en Ajustes."
          }
        }
      }
    },
    "Powers your discount barcode and widgets. Stored in the Keychain on this device.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa tu código de barras de descuento y widgets. Se guarda en el Llavero de este dispositivo."
          }
        }
      }
    },
    "Home shows the high/low forecast for your work city.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicio muestra el pronóstico de máxima/mínima de tu ciudad de trabajo."
          }
        }
      }
    },
    "The whole app follows this palette. You can fine-tune Light and Dark later in Settings.": {
      "extractionState": "manual",
      "localizations": {
