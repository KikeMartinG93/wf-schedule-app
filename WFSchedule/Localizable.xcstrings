    },
    "A bigger countdown that shifts from green to red." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cuenta regresiva más grande que pasa de verde a rojo."
          }
        }
      }
    },
    "A meal period is required, but you and your manager can agree to skip it since your shift is 6 hours or less." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se requiere un período de comida, pero tú y tu gerente pueden acordar omitirlo porque tu turno es de 6 horas o menos."
          }
        }
      }
    },
    "A new ring design for the Home Screen, Lock Screen and Apple Watch that shifts from green to red as your break gets close." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nuevo diseño de anillo para la pantalla de inicio, la pantalla de bloqueo y el Apple Watch que cambia de verde a rojo a medida que se acerca tu descanso."
          }
        }
      }
    },
    "A sleeker Breaks sheet" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una hoja de descansos más elegante"
