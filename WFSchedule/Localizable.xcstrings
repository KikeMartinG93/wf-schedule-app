    },
    "High contrast and font choice" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alto contraste y elección de fuente"
          }
        }
      }
    },
    "High contrast switches the whole app, widgets and Live Activity to plain black, white and gray with flat backgrounds. Turn off Rounded font to use the standard system font. Widgets follow the font choice." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El alto contraste cambia toda la app, los widgets y la actividad en vivo a negro, blanco y gris con fondos planos. Desactiva la fuente redondeada para usar la fuente estándar del sistema. Los widgets siguen la elección de fuente."
          }
        }
      }
    },
    "High contrast turns the app, widgets and Live Activity plain black, white and gray. Some items, like dates and notifications, update after you restart the app." : {

    },
    "Higher-contrast colors, VoiceOver support for the calendar, and the rounded system font throughout the app." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colores con más contraste, compatibilidad con VoiceOver en el calendario y la fuente redondeada del sistema en toda la app."
          }
        }
      }
    },
